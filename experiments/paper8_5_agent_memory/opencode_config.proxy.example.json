{
  "$schema": "https://opencode.ai/config.json",
  "model": "pra/qwen3-coder:30b",
  "small_model": "pra/qwen3-coder:30b",
  "enabled_providers": ["pra"],
  "provider": {
    "pra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Controlled PRA evaluation endpoint",
      "options": {
        "apiKey": "dummy",
        "baseURL": "http://host.docker.internal:18185/v1",
        "timeout": 3600000
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 1024
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "lsp": "deny"
  },
  "share": "disabled",
  "autoupdate": false,
  "experimental": {
    "openTelemetry": false
  }
}
