    },
    "search_files": {
      "category": "filesystem",
      "operation_kind": "search_discovery",
      "resource_arguments": ["path"]
    },
    "list_files": {
      "category": "filesystem",
      "operation_kind": "search_discovery",
      "resource_arguments": ["path"]
    },
    "edit": {
      "category": "filesystem",
      "operation_kind": "write",
