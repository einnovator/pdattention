{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openai-compatible/qwen3-coder:30b-ctx64k",
  "enabled_providers": ["openai-compatible"],
  "provider": {
    "openai-compatible": {
      "options": {
        "apiKey": "paper85-local",
        "baseURL": "http://host.docker.internal:18185/v1",
        "timeout": 3600000
      },
      "models": {
        "qwen3-coder:30b-ctx64k": {
          "name": "Qwen3-Coder-30B controlled 64K",
          "tool_call": true,
          "limit": {"context": 65536, "output": 1024}
        }
      }
    }
  },
  "permission": "allow",
  "formatter": false,
  "lsp": false,
  "experimental": {"openTelemetry": false}
}
