+                    (int) ranges.size(), source.id, selected_tokens, task.pra_source_tokens, task.pra_wire_tokens);
+        } else if (task.pra_resource_slot >= 0) {
+            if (!params_base.kv_unified) {
+                send_error(task, "PRA native attachment requires --kv-unified", ERROR_TYPE_INVALID_REQUEST);
+                return false;
+            }
+            if (task.pra_resource_slot >= (int32_t) slots.size()) {
+                send_error(task, "PRA resource slot is out of range", ERROR_TYPE_INVALID_REQUEST);
+                return false;
+            }
+
+            auto & source = slots[task.pra_resource_slot];
+            if (source.id == slot.id) {
+                send_error(task, "PRA resource and request slots must differ", ERROR_TYPE_INVALID_REQUEST);
+                return false;
