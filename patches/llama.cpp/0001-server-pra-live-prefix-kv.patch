+                return false;
+            }
+
+            auto ranges = task.pra_selected_ranges;
+            auto & registered = pra_record_ranges[source.id];
+            for (auto & range : ranges) {
+                const auto found = registered.find(range.record_id);
+                if (found != registered.end()) {
+                    const auto & stable = found->second;
+                    const bool identity_only = range.parent_record_id.empty() &&
+                            range.causal_group_id.empty() && range.start == 0 && range.end == 0;
+                    if (identity_only) {
+                        range = stable;
+                    } else if (range.parent_record_id != stable.parent_record_id ||
+                            range.causal_group_id != stable.causal_group_id ||
+                            range.start != stable.start || range.end != stable.end) {
+                        send_error(task, "PRA record ID was reused with different source coordinates", ERROR_TYPE_INVALID_REQUEST);
+                        return false;
+                    }
+                } else {
+                    if (range.record_id.empty() || range.parent_record_id.empty() ||
+                            range.causal_group_id.empty() || range.start < 0 || range.end <= range.start) {
+                        send_error(task, "An unregistered PRA record requires stable IDs and source coordinates", ERROR_TYPE_INVALID_REQUEST);
+                        return false;
+                    }
+                }
+            }
+            std::sort(ranges.begin(), ranges.end(), [](const auto & left, const auto & right) {
+                return std::tie(left.start, left.end) < std::tie(right.start, right.end);
+            });
+            llama_pos previous_end = -1;
+            int32_t selected_tokens = 0;
+            for (const auto & range : ranges) {
+                if (range.record_id.empty() || range.parent_record_id.empty() || range.causal_group_id.empty()) {
+                    send_error(task, "PRA ranges require record, parent, and causal-group IDs", ERROR_TYPE_INVALID_REQUEST);
+                    return false;
+                }
+                if (range.start < 0 || range.end <= range.start || range.end > source.prompt.n_tokens()) {
+                    send_error(task, "PRA selected range is outside the live source prefix", ERROR_TYPE_INVALID_REQUEST);
+                    return false;
+                }
+                if (range.start < previous_end) {
+                    send_error(task, "PRA selected ranges must not overlap", ERROR_TYPE_INVALID_REQUEST);
+                    return false;
+                }
+                previous_end = range.end;
+                selected_tokens += range.end - range.start;
+            }
+            for (const auto & range : ranges) {
+                registered.emplace(range.record_id, range);
+            }
+
+            source.pra_resource_pinned = true;
+            llama_tokens query = task.tokens.get_text_tokens();
+            const llama_token bos = llama_vocab_bos(vocab);
+            if (!query.empty() && !source.prompt.tokens.empty() &&
+                    query.front() == bos && source.prompt.tokens[0] == bos) {
+                query.erase(query.begin());
+            }
+            if (source.prompt.n_tokens() + (int32_t) query.size() >= slot.n_ctx) {
+                send_error(task, "PRA logical source plus query exceeds the request context", ERROR_TYPE_EXCEED_CONTEXT_SIZE);
+                return false;
+            }
+
+            slot.prompt_clear();
+            for (const auto & range : ranges) {
+                // seq_cp adds destination membership to the exact existing
+                // cells. No K/V data are copied and no selected text is run
+                // through the model again.
+                slot.mem.seq_cp(source.id, slot.id, range.start, range.end);
+            }
+            slot.prompt = source.prompt.clone();
+            slot.prompt.checkpoints.clear();
