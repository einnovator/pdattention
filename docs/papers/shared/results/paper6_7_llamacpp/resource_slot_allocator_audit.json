{
  "schema_version": "paper6.7-resource-slot-allocator-v1",
  "evidence_tier": "CONTROL_PLANE_LIFECYCLE_TEST",
  "server_transport_scope": "one selected resource sequence per request",
  "checks": {
    "resource_request_pools_disjoint": true,
    "distinct_active_resource_slots": true,
    "distinct_active_request_slots": true,
    "cross_tenant_attach_blocked": true,
    "active_resource_eviction_blocked": true,
    "session_release_returned_owned_slot": true,
    "released_slot_reused": true
  },
  "allocator": {
    "resource_capacity": 2,
    "request_capacity": 2,
    "resident_resources": 2,
    "active_requests": 0,
    "max_resources_per_request": 1,
    "tenant_scoped": true,
    "session_scoped": true,
    "model_scoped": true
  },
  "claims": {
    "tenant_isolation": "control-plane enforced",
    "session_invalidation": "fail-closed while active",
    "active_resource_eviction": "forbidden",
    "multi_resource_native_geometry": "not implemented"
  }
}
